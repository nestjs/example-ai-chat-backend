DATABASE_URL=postgres://postgres:assistant@localhost:5432/assistant
# Generate with: openssl rand -base64 32
JWT_SECRET=
# Either your Anthropic API key...
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ...or the scripted model, which needs none (development only).
AI_MODEL=fake

# Optional, with their defaults:
# PORT=3000
# NODE_ENV=development
# Browser origins allowed to call the API, comma-separated. None by default.
# CORS_ORIGINS=http://localhost:5173
# The most output tokens of one model call (1-8000).
# AI_MAX_OUTPUT_TOKENS=1000

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
